.venv/
.venv_acl_broken_*/
.idea/
.env
__pycache__/
.pytest_cache/
*.py[cod]
data/raw/*
data/processed/*
# Run artefacts. Snapshots are the local record of sessions this machine
# observed; they are the point of the archive and they are not source. Keeping
# them out also keeps market data out of a public repo.
data/validated/
data/manifests/
data/quarantine/
reports/*
models/*
data/raw/news/
data/raw/alfred/
*.llm-response.json
!data/raw/.gitkeep
!data/raw/fixtures/
!data/raw/fixtures/**
!data/processed/.gitkeep
!reports/.gitkeep
!models/.gitkeep

# pytest scratch, used only when the system temp dir is unusable
.pytest-tmp/

# Local continuation scratch for the user's workflow harness, not project files
msl_continue*.txt

# Daily report state and event machine are per-machine records
data/events.json
reports/daily_report_*
reports/reconciliation_*
